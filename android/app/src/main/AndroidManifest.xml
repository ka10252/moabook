<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 커스텀 스킴 moabook:// — 도메인 검증 없이 바로 동작한다.
                 App Links(아래)가 준비되기 전까지의 확실한 경로이고,
                 준비된 뒤에도 남겨둔다(메일 클라이언트가 https를 가로채는 경우가 있다). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="moabook" />
            </intent-filter>

            <!-- App Links — 메일의 https 링크를 브라우저 대신 앱이 받는다.
                 도메인은 확정됐다(moabook.vercel.app). 남은 건 하나:
                   public/.well-known/assetlinks.json 올리기
                   — 앱 서명 인증서의 SHA-256 지문이 들어간다. 서명 키를 만든 뒤에야 채울 수 있다.
                 지문을 넣고 배포한 다음 아래 주석을 풀면 된다.
                 그때까지는 위의 moabook:// 스킴으로 동작한다.

                 참고: vercel.app은 Public Suffix List에 있어 서브도메인이
                 독립 사이트로 취급된다 — App Links/Universal Links 둘 다 쓸 수 있다.

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="moabook.vercel.app" android:pathPrefix="/auth" />
            </intent-filter>
            -->

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
