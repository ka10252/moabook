# ─────────────────────────────────────────────────────────────
# 프론트엔드 (.env) — 이 값들은 브라우저에 그대로 실려 나간다.
# VITE_ 로 시작하는 건 전부 공개된다고 봐야 한다. 비밀키를 넣지 말 것.
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_GOOGLE_BOOKS_API_KEY=

# 웹 푸시 공개키. `npx web-push generate-vapid-keys` 로 만든 것 중 public 쪽.
# 비밀키(private)는 여기 넣지 말 것 — Supabase Edge Function Secrets 에만 넣는다.
VITE_VAPID_PUBLIC_KEY=


# ─────────────────────────────────────────────────────────────
# 메일 발송 (.env.local) — `supabase config push` 가 읽는다.
# 브라우저로 나가지 않는다. 절대 git에 올리지 말 것.
# ─────────────────────────────────────────────────────────────
#
# 지금: Gmail SMTP (도메인 불필요, 스팸함 안 감, 하루 500통)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_USER=moabook.sg@gmail.com     ← 서비스 전용 계정. 개인 gmail 쓰지 말 것
#   SMTP_PASS=abcdefghijklmnop         ← Google 앱 비밀번호 16자리 (로그인 비번 아님)
#   SMTP_SENDER=moabook.sg@gmail.com
#   → myaccount.google.com/apppasswords 에서 발급 (2단계 인증 켜야 나옴)
#   → 개인 계정을 쓰면 유저 전원에게 내 개인 주소가 노출되고, Google이 계정을 제한할 때
#     내 실제 메일·드라이브까지 묶인다. 반드시 전용 계정을 새로 만들 것.
#
# 나중에 (공개 런칭, 도메인 구매 후): Resend
#   SMTP_HOST=smtp.resend.com
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxx          ← Resend API 키
#   SMTP_SENDER=noreply@내도메인.com    ← Resend에서 인증한 도메인의 주소
#
# ❌ SendGrid Single Sender 는 쓰지 말 것.
#    gmail 주소를 발신자로 쓰면 SPF·DKIM·DMARC가 전부 실패해서 스팸함으로 간다.
#    자세한 이유: docs/EMAIL_SETUP.md
#
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=

# 네이티브 앱(iOS·Android) 전용 — 인증 메일이 돌아올 실제 웹 주소.
# 앱은 capacitor://localhost 에서 도는데 그 주소는 메일에서 열 수 없고
# Supabase 허용 목록에도 못 넣는다. 그래서 앱 빌드에는 이 값이 반드시 있어야 한다.
# 없으면 가입 확인 메일을 눌러도 앱으로 돌아오지 못해 가입을 끝낼 수 없다.
#   VITE_PUBLIC_SITE_URL=https://moabook.app
VITE_PUBLIC_SITE_URL=
